import 'dart:math';
import 'package:flutter/material.dart';

void main() {
  runApp(const BusGame());
}

class BusGame extends StatelessWidget {
  const BusGame({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark(),
      home: const BusRoad(),
    );
  }
}

class BusRoad extends StatefulWidget {
  const BusRoad({super.key});

  @override
  State<BusRoad> createState() => _BusRoadState();
}

class _BusRoadState extends State<BusRoad>
    with SingleTickerProviderStateMixin {
  late AnimationController controller;
  final Random random = Random();

  double bus1 = 0.05;
  double bus2 = 0.45;
  double bus3 = 0.75;

  bool bus1Stopped = false;
  bool bus2Stopped = false;
  bool bus3Stopped = false;

  @override
  void initState() {
    super.initState();

    controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 30),
    )..addListener(() {
        setState(() {
          if (!bus1Stopped) bus1 += 0.002;
          if (!bus2Stopped) bus2 += 0.002;
          if (!bus3Stopped) bus3 += 0.002;

          if (bus1 > 1) bus1 = 0;
          if (bus2 > 1) bus2 = 0;
          if (bus3 > 1) bus3 = 0;
        });
      });

    controller.repeat();
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  Widget bus(double position, bool stopped) {
    final scale = 0.45 + position * 1.2;

    return Positioned(
      bottom: 120 + position * 230,
      left: MediaQuery.of(context).size.width / 2 - (45 * scale),
      child: Transform.scale(
        scale: scale,
        child: Container(
          width: 90,
          height: 55,
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [Colors.red, Colors.deepOrange],
            ),
            borderRadius: BorderRadius.circular(10),
            boxShadow: const [
              BoxShadow(
                color: Colors.black54,
                blurRadius: 12,
                offset: Offset(0, 6),
              )
            ],
          ),
          child: Column(
            children: [
              Container(
                margin: const EdgeInsets.all(6),
                height: 20,
                decoration: BoxDecoration(
                  color: Colors.lightBlue.shade100,
                  borderRadius: BorderRadius.circular(4),
                ),
                child: const Center(
                  child: Text(
                    "BUS",
                    style: TextStyle(
                      color: Colors.black,
                      fontWeight: FontWeight.bold,
                      fontSize: 9,
                    ),
                  ),
                ),
              ),
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                children: [
                  wheel(),
                  wheel(),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget wheel() {
    return Container(
      width: 13,
      height: 13,
      decoration: const BoxDecoration(
        color: Colors.black,
        shape: BoxShape.circle,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Stack(
        children: [
          // Sky
          Container(
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topCenter,
                end: Alignment.bottomCenter,
                colors: [
                  Color(0xFF62B7FF),
                  Color(0xFFEAF7FF),
                  Color(0xFF8BC34A),
                ],
                stops: [0, 0.55, 0.56],
              ),
            ),
          ),

          // Road
          Positioned.fill(
            top: 350,
            child: CustomPaint(
              painter: RoadPainter(),
            ),
          ),

          // Bus stop
          Positioned(
            right: 20,
            bottom: 170,
            child: Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.blue.shade800,
                borderRadius: BorderRadius.circular(10),
              ),
              child: const Column(
                children: [
                  Icon(Icons.directions_bus, size: 35),
                  Text(
                    "BUS STOP",
                    style: TextStyle(fontWeight: FontWeight.bold),
                  ),
                ],
              ),
            ),
          ),

          bus(bus1, bus1Stopped),
          bus(bus2, bus2Stopped),
          bus(bus3, bus3Stopped),

          // Game controls
          Positioned(
            bottom: 25,
            left: 20,
            child: ElevatedButton(
              onPressed: () {
                setState(() {
                  bus1Stopped = !bus1Stopped;
                });
              },
              child: Text(
                bus1Stopped ? "START BUS" : "STOP BUS",
              ),
            ),
          ),

          Positioned(
            top: 45,
            left: 20,
            child: Container(
              padding: const EdgeInsets.all(10),
              decoration: BoxDecoration(
                color: Colors.black54,
                borderRadius: BorderRadius.circular(12),
              ),
              child: const Text(
                "CITY BUS SIMULATOR",
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class RoadPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final road = Paint()..color = const Color(0xFF303030);

    final roadPath = Path()
      ..moveTo(size.width * .25, 0)
      ..lineTo(size.width * .75, 0)
      ..lineTo(size.width, size.height)
      ..lineTo(0, size.height)
      ..close();

    canvas.drawPath(roadPath, road);

    final line = Paint()
      ..color = Colors.white
      ..strokeWidth = 6;

    for (double y = 20; y < size.height; y += 55) {
      canvas.drawLine(
        Offset(size.width / 2, y),
        Offset(size.width / 2, y + 25),
        line,
      );
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;
}
